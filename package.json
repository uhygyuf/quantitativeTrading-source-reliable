{
  "name": "quantitativeTrading-source-reliable",
  "version": "0.1.3",
  "description": "Verified, agent-collectable sources for quantitative finance and crypto trading: regulator filings, PIT fundamentals, macro, exchange APIs, on-chain data and archives, each with authority tier, verification state, five-state PIT and dataset tags. · 量化金融与加密交易信源插件：监管原始文件、PIT 基本面、宏观、交易所 API、链上数据与归档，按权威分级并标注验证状态、PIT 五态与数据集标签。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/registry.js",
    "lib/guidance.js",
    "lib/tool-defs.js",
    "data/sources.json",
    "data/enrichment.yaml",
    "data/quant-source-matrix.yaml",
    "data/crypto-source-matrix.yaml",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "assets/icon-180.png",
    "assets/icon-512.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/check.mjs",
    "build:data": "node tools/build-data.cjs",
    "probe": "node tools/probe-sources.cjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sources",
    "quant",
    "crypto",
    "market-data",
    "point-in-time",
    "reliability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uhygyuf/quantitativeTrading-source-reliable.git"
  },
  "homepage": "https://github.com/uhygyuf/quantitativeTrading-source-reliable#readme",
  "bugs": {
    "url": "https://github.com/uhygyuf/quantitativeTrading-source-reliable/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
